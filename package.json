{
  "name": "envsync",
  "version": "0.1.0",
  "description": "Type-Safe Environment Management for Modern JavaScript Applications",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "envsync": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/plugins/vite.d.ts",
      "import": "./dist/plugins/vite.mjs",
      "require": "./dist/plugins/vite.js"
    },
    "./next": {
      "types": "./dist/plugins/next.d.ts",
      "import": "./dist/plugins/next.mjs",
      "require": "./dist/plugins/next.js"
    },
    "./payload": {
      "types": "./dist/plugins/payload.d.ts",
      "import": "./dist/plugins/payload.mjs",
      "require": "./dist/plugins/payload.js"
    },
    "./nest": {
      "types": "./dist/plugins/nest.d.ts",
      "import": "./dist/plugins/nest.mjs",
      "require": "./dist/plugins/nest.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "release": "npm run build && changeset publish"
  },
  "keywords": [
    "env",
    "environment",
    "typescript",
    "validation",
    "schema",
    "process.env",
    "nextjs",
    "vite",
    "nestjs"
  ],
  "author": "Himanshu Roy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Marshal-Roy/env-sync.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^14.0.3",
    "dotenv": "^16.4.5",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@nestjs/common": "^11.1.29",
    "@types/node": "^22.1.0",
    "next": "^16.3.0",
    "payload": "^3.87.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.21",
    "vitest": "^2.0.5"
  }
}
